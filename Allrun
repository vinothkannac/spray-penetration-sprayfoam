#!/usr/bin/env bash
# I use this to run the whole study: create the cases, mesh them, run sprayFoam for all
# mesh levels and analyse the results.
# It needs a sourced OpenFOAM (ESI v2306+ recommended) and Python 3 with requirements.txt.
#   NPROCS=4 ./Allrun        # optional parallel run (see the note below)
set -euo pipefail
cd "$(dirname "$0")"

: "${WM_PROJECT_DIR:?Source your OpenFOAM environment first}"
NPROCS="${NPROCS:-1}"

python3 scripts/make_cases.py

for level in coarse medium fine; do
    echo "=== $level ==="
    pushd "cases/$level" > /dev/null
    blockMesh > log.blockMesh 2>&1
    checkMesh > log.checkMesh 2>&1 || true
    if [ "$NPROCS" -gt 1 ]; then
        # For a parallel run, I first need to check that the tutorial has decomposeParDict and
        # that reconstructPar also rebuilds the parcel cloud in this OpenFOAM version.
        foamDictionary -entry numberOfSubdomains -set "$NPROCS" system/decomposeParDict > /dev/null
        decomposePar -force > log.decomposePar 2>&1
        mpirun -np "$NPROCS" sprayFoam -parallel > log.sprayFoam 2>&1
        reconstructPar -newTimes > log.reconstructPar 2>&1
    else
        sprayFoam > log.sprayFoam 2>&1
    fi
    popd > /dev/null
done

python3 analysis/run_analysis.py --params params.json --cases cases --out results
echo "Done. See results/ (summary.json, validation_table.md, figures/*.png)."
