#!/usr/bin/env bash
# I use this to remove the generated cases, the synthetic test data and the rendered frames.
# I keep the committed files in results/. run_analysis.py overwrites them on the next run.
cd "$(dirname "$0")"
rm -rf cases/coarse cases/medium cases/fine tests/synthetic tests/synthetic_results results/frames
find . -name __pycache__ -not -path './.venv/*' -type d -prune -exec rm -rf {} +
echo "cleaned"
