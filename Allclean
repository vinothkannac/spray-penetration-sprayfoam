#!/usr/bin/env bash
# Remove generated cases, synthetic test data and rendered frames.
# The committed files in results/ are kept; run_analysis.py overwrites them on the next run.
cd "$(dirname "$0")"
rm -rf cases/coarse cases/medium cases/fine tests/synthetic tests/synthetic_results results/frames
find . -name __pycache__ -not -path './.venv/*' -type d -prune -exec rm -rf {} +
echo "cleaned"
