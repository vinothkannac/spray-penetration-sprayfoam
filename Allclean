#!/usr/bin/env bash
# Remove generated cases and results (keeps params.json and all scripts).
cd "$(dirname "$0")"
rm -rf cases/coarse cases/medium cases/fine tests/synthetic tests/synthetic_results
find results -type f ! -name .gitkeep -delete
find results -mindepth 1 -type d -empty -delete
find . -name __pycache__ -not -path './.venv/*' -type d -prune -exec rm -rf {} +
echo "cleaned"
